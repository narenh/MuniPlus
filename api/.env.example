# Copy to api/.env for local development. In Coolify, set these as environment variables.

# 511 key. Staging uses the 60/hr dev key; leave empty locally unless running scripts/seed.py.
API_511_KEY=

# 1 = replay recorded feeds from tests/fixtures and never call 511.
FIXTURES=0

# Poll intervals in seconds. The defaults are the dev-key rates: 43 calls/hr.
POLL_ARRIVALS_SECONDS=180
POLL_VEHICLES_SECONDS=180
POLL_ALERTS_SECONDS=1200
# Hard ceiling on 511 calls per rolling hour, enforced by the client.
BUDGET_PER_HOUR=55

# Where the sf-transit checkout and the SQLite database live (a persistent volume in Coolify).
DATA_DIR=/data
DATA_REPO=git@github.com:narenh/sf-transit.git
DATA_BRANCH=main
# Private half of the sf-transit deploy key (write access). Only needed where the editor pushes.
DATA_DEPLOY_KEY=
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# Editor login.
EDITOR_PASSWORD=
# Signs the editor session cookie. Any long random string; changing it logs everyone out.
SESSION_SECRET=
