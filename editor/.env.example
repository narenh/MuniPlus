# Copy to editor/.env for local development. In Coolify, set these as environment variables.
# An empty value means the default.

# Where the data checkout (DATA_DIR/data) and a pending snapshot refresh live.
# A persistent volume in Coolify; the image already sets /data.
DATA_DIR=
# The data repo and branch the editor clones, commits to and pushes.
# Defaults: git@github.com:narenh/canopy-transit-editor.git, static-data.
DATA_REPO=
DATA_BRANCH=
# Private half of a deploy key with write access to DATA_REPO. Needed for an SSH
# DATA_REPO: without it the editor is read-only.
DATA_DEPLOY_KEY=
# Author of the editor's commits. Without an email the editor is read-only.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# Editor login. Empty serves /editor read-only to anyone.
EDITOR_PASSWORD=
# Signs the editor session cookie. Any long random string; changing it logs everyone out.
SESSION_SECRET=

# The Canopy Transit Relay, which holds the 511 key. Default: https://transit-relay.canopysf.com
RELAY_URL=
# 511 operator codes, as JSON. Default: ["SF"]. The relay only serves SF.
OPERATORS=
